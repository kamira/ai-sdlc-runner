[222.4874, "o", "\r\n"]
[222.4899, "o", "================================== FAILURES ==================================="]
[222.4899, "o", "\r\n"]
[222.4899, "o", "____________ test_the_test_count_the_readme_states_is_the_real_one ____________"]
[222.4899, "o", "\r\n"]
[222.4899, "o", "\r\n"]
[222.4899, "o", "    def test_the_test_count_the_readme_states_is_the_real_one():"]
[222.4899, "o", "\r\n"]
[222.4899, "o", "        \"\"\"The one figure this file could not see, and which a seat caught drifting twice."]
[222.4899, "o", "\r\n"]
[222.4899, "o", "    "]
[222.4899, "o", "\r\n"]
[222.4899, "o", "        The README said \"847 passing\" when 857 did. A suite cannot count itself while running, so this"]
[222.4899, "o", "\r\n"]
[222.4899, "o", "        counts it in a subprocess."]
[222.4899, "o", "\r\n"]
[222.4899, "o", "    "]
[222.4899, "o", "\r\n"]
[222.4899, "o", "        **It states a collected count, not a passing one, and that is the correction.** The first"]
[222.4899, "o", "\r\n"]
[222.4899, "o", "        version compared against collected-minus-skips and called the skips \"counted, not guessed\" —"]
[222.4899, "o", "\r\n"]
[222.4899, "o", "        they were always guessed: `--collect-only` never emits `SKIPPED`, so the fallback constant ran"]
[222.4899, "o", "\r\n"]
[222.4899, "o", "        on every machine. Both skips here are `curses` importorskips; on CI's Ubuntu they execute and"]
[222.4899, "o", "\r\n"]
[222.4899, "o", "        `pytest -q` prints two more passes than this machine. The README's number would have been false"]
[222.4899, "o", "\r\n"]
[222.4899, "o", "        there and this test would still have passed, because it subtracted the same constant everywhere."]
[222.4899, "o", "\r\n"]
[222.4899, "o", "    "]
[222.4899, "o", "\r\n"]
[222.4899, "o", "        A count that is machine-independent is the only one a document can state. How many of them pass"]
[222.4899, "o", "\r\n"]
[222.4899, "o", "        on a given machine is a property of that machine."]
[222.4899, "o", "\r\n"]
[222.4899, "o", "        \"\"\""]
[222.4899, "o", "\r\n"]
[222.4899, "o", "        import os"]
[222.4899, "o", "\r\n"]
[222.4899, "o", "        import re"]
[222.4899, "o", "\r\n"]
[222.4899, "o", "        import subprocess"]
[222.4899, "o", "\r\n"]
[222.4899, "o", "        import sys"]
[222.4899, "o", "\r\n"]
[222.4899, "o", "    "]
[222.4899, "o", "\r\n"]
[222.4899, "o", "        root = Path(__file__).resolve().parents[1]"]
[222.4899, "o", "\r\n"]
[222.4899, "o", "        readme = (root / \"README.md\").read_text(encoding=\"utf-8\")"]
[222.4899, "o", "\r\n"]
[222.4899, "o", "        claimed = re.search(r\"pytest -q\\s*#\\s*([\\d,]+) tests\", readme)"]
[222.4899, "o", "\r\n"]
[222.4899, "o", "        if claimed is None:"]
[222.4899, "o", "\r\n"]
[222.4899, "o", "            return                          # the README no longer states one; nothing to hold it to"]
[222.4899, "o", "\r\n"]
[222.4899, "o", "        want = int(claimed.group(1).replace(\",\", \"\"))"]
[222.4899, "o", "\r\n"]
[222.4899, "o", "    "]
[222.4899, "o", "\r\n"]
[222.4899, "o", "        done = subprocess.run("]
[222.4899, "o", "\r\n"]
[222.4899, "o", "            [sys.executable, \"-m\", \"pytest\", \"tests/\", \"--collect-only\", \"-q\"],"]
[222.4899, "o", "\r\n"]
[222.4899, "o", "            capture_output=True, text=True, encoding=\"utf-8\", errors=\"replace\", cwd=str(root),"]
[222.4899, "o", "\r\n"]
[222.4899, "o", "            env={**os.environ, \"PYTHONPATH\": \"src\", \"PYTHONUTF8\": \"1\"})"]
[222.4899, "o", "\r\n"]
[222.4899, "o", "        found = re.search(r\"(\\d+) tests collected\", done.stdout or \"\")"]
[222.4899, "o", "\r\n"]
[222.4899, "o", "        assert found, f\"could not count the suite:\\n{(done.stdout or '')[-400:]}\""]
[222.4899, "o", "\r\n"]
[222.4899, "o", ">       assert int(found.group(1)) == want, ("]
[222.4899, "o", "\r\n"]
[222.4899, "o", "            f\"the README says {want} tests; the suite collects {found.group(1)}\")"]
[222.4899, "o", "\r\n"]
[222.4899, "o", "E       AssertionError: the README says 1285 tests; the suite collects 1295"]
[222.492, "o", "\r\n"]
[222.492, "o", "E       assert 1295 == 1285"]
[222.492, "o", "\r\n"]
[222.492, "o", "E        +  where 1295 = int('1295')"]
[222.492, "o", "\r\n"]
[222.492, "o", "E        +    where '1295' = <built-in method group of re.Match object at 0x000001F1BD85FE20>(1)"]
[222.492, "o", "\r\n"]
[222.492, "o", "E        +      where <built-in method group of re.Match object at 0x000001F1BD85FE20> = <re.Match object; span=(110390, 110410), match='1295 tests collected'>.group"]
[222.492, "o", "\r\n"]
